{
  "tenantId": "example",
  "name": "Example Tenant",
  "redactDirectIdentifiers": true,
  "retentionDays": 30,
  "dataResidencyMode": "standard",
  "requireCustomerConsent": false,
  "llm": {
    "enabled": false,
    "model": "claude-sonnet-4-20250514",
    "apiKey": { "provider": "env", "env": "ANTHROPIC_API_KEY" }
  },
  "auth": {
    "apiKeys": [
      {
        "keyId": "support-ops",
        "actorId": "support-ops",
        "secret": { "provider": "env", "env": "EXAMPLE_TENANT_API_KEY" },
        "roles": ["read", "process", "review", "sync"]
      }
    ]
  },
  "providers": {
    "support": {
      "type": "zendesk",
      "baseUrl": "https://example.zendesk.com",
      "email": { "provider": "env", "env": "ZENDESK_EMAIL" },
      "apiToken": { "provider": "env", "env": "ZENDESK_API_TOKEN" }
    },
    "logs": {
      "type": "http-logs",
      "baseUrl": "https://observability.internal.example",
      "path": "/logs",
      "bearerToken": { "provider": "env", "env": "LOGS_API_TOKEN" }
    },
    "session": {
      "type": "http-session",
      "baseUrl": "https://replay.internal.example",
      "path": "/sessions",
      "bearerToken": { "provider": "env", "env": "SESSION_API_TOKEN" }
    },
    "featureFlags": {
      "type": "http-flags",
      "baseUrl": "https://flags.internal.example",
      "path": "/flags",
      "bearerToken": { "provider": "env", "env": "FLAGS_API_TOKEN" }
    },
    "release": {
      "type": "http-release",
      "baseUrl": "https://deploys.internal.example",
      "path": "/release",
      "bearerToken": { "provider": "env", "env": "RELEASE_API_TOKEN" }
    },
    "github": {
      "type": "github",
      "baseUrl": "https://api.github.com",
      "owner": "example-org",
      "repo": "repro-packs",
      "token": { "provider": "env", "env": "GITHUB_TOKEN" },
      "labels": ["support", "bug", "repro-pack"]
    },
    "jira": {
      "type": "jira",
      "baseUrl": "https://example.atlassian.net",
      "projectKey": "SUP",
      "issueType": "Bug",
      "email": { "provider": "env", "env": "JIRA_EMAIL" },
      "apiToken": { "provider": "env", "env": "JIRA_API_TOKEN" },
      "labels": ["support", "repro-pack"],
      "priority": "High",
      "components": ["Support"],
      "customFields": {
        "customfield_10001": "repro-pack"
      }
    },
    "slack": {
      "enabled": false,
      "webhookUrl": { "provider": "env", "env": "SLACK_WEBHOOK_URL" },
      "channel": "#repro-approvals"
    },
    "webhook": {
      "enabled": false,
      "url": "https://your-service.com/hooks/repro",
      "secret": { "provider": "env", "env": "WEBHOOK_SECRET" },
      "events": ["pack.processed", "pack.approved", "pack.synced"]
    }
  }
}
