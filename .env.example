PORT=3000
LOG_LEVEL=info
FIXTURE_ROOT=fixtures/cases
ARTIFACT_OUTPUT_DIR=artifacts
DATA_ROOT=data
TENANT_CONFIG_ROOT=tenants
STORAGE_DRIVER=fs
SQLITE_DATABASE_PATH=data/repro-pack.sqlite
PROCESS_TIMEOUT_MS=2500
HTTP_TIMEOUT_MS=5000
# Timeout for optional Anthropic repro-step suggestions.
LLM_TIMEOUT_MS=10000
MAX_PROVIDER_RETRIES=2
QUEUE_POLL_MS=250
QUEUE_LEASE_MS=30000
QUEUE_MAX_ATTEMPTS=3
RETENTION_DAYS=30
REDACT_IPS=true
REDACT_DIRECT_IDENTIFIERS=true
DATA_RESIDENCY_MODE=standard
REQUIRE_CUSTOMER_CONSENT=false
APP_VERSION=1.0.0
BUILD_HASH=not available
API_KEY=change-me
# Optional Anthropic key for tenants with llm.enabled=true.
ANTHROPIC_API_KEY=
# Optional Slack Incoming Webhook URL for approval notifications.
SLACK_WEBHOOK_URL=
# Optional public/internal base URL used to include pack links in notifications.
BASE_URL=
# Optional shared secret for outbound signed webhooks.
WEBHOOK_SECRET=
